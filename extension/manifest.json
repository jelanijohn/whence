{
  "manifest_version": 3,
  "name": "Whence: Browser LLM sensor",
  "version": "0.4.0",
  "description": "Feeds browser AI chat project identity into the local Whence widget. Reads the self-declared project only, never chat content.",
  "homepage_url": "https://github.com/jelanijohn/whence",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["providers.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
